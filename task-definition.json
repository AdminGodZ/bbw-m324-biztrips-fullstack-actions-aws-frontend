        "interval": 15,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 15
      },
      "systemControls": []
    }
  ],
  "family": "bbw-m324-biztrips-frontend",
  "taskRoleArn": "arn:aws:iam::471112806058:role/LabRole",
  "executionRoleArn": "arn:aws:iam::471112806058:role/LabRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
