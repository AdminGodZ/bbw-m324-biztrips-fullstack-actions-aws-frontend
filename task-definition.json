{
  "containerDefinitions": [
    {
      "name": "biztrips-frontend",
      "image": "471112806058.dkr.ecr.us-east-1.amazonaws.com/bbw-m324-biztrips-refcard03-04-frontend:965c5583192eeb3a43d3c38564c5a075fe8fa743",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "BACKEND_ORIGIN",
          "value": "http://bbw-m324-Alb-BD6YtmTDd85r-713603972.us-east-1.elb.amazonaws.com"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bbw-m324-biztrips-refcard03-04",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "frontend"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -q -O /dev/null http://127.0.0.1:80/health || exit 1"
